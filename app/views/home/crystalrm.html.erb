<!DOCTYPE html>
<html lang="en" class="h-full bg-white antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wiki - CrystalRM</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex flex-col text-slate-800 bg-slate-50">

  <!-- ================= TOP HEADER BAR ================= -->
  <header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      
      <!-- Brand & Mobile Menu Toggle -->
      <div class="flex items-center gap-4">
        <button type="button" class="lg:hidden text-slate-500 hover:text-slate-700 focus:outline-none">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <a href="#" class="flex items-center gap-2 font-bold text-slate-900 tracking-tight text-lg">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-rose-600 text-white font-black text-sm">C</span>
          Crystal<span class="text-rose-600">Wiki</span>
        </a>
      </div>

      <!-- Quick Search Bar -->
      <div class="flex flex-1 max-w-md mx-6">
        <label for="search" class="sr-only">Search wiki</label>
        <div class="relative w-full">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="search" 
            id="search"
            placeholder="Search pages, terms, schemas..." 
            class="w-full rounded-lg border border-slate-200 bg-slate-50 py-1.5 pl-9 pr-3 text-sm placeholder:text-slate-400 focus:border-rose-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-rose-500 transition-colors"
          />
          <kbd class="hidden sm:inline-block absolute right-2.5 top-2 rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[10px] font-semibold text-slate-400">⌘K</kbd>
        </div>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-2">
        <button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>New Page</span>
        </button>
        <button type="button" class="rounded-full p-1 text-slate-500 hover:text-slate-800">
          <span class="sr-only">User profile</span>
          <div class="h-7 w-7 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-xs font-semibold">G</div>
        </button>
      </div>