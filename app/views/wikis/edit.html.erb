<% page_title = @wiki.try(:title) || @wiki.try(:name) || "Wiki ##{@wiki.id}" %>
<% content_for :title, "Editing: #{page_title}" %>

<div class="mx-auto flex w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8 py-8">
  <div class="w-full max-w-3xl mx-auto">
    
    <!-- Top Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-xs text-slate-500 mb-4 pb-3 border-b border-slate-200">
      <%= link_to "Wiki", wikis_path, class: "hover:text-slate-800" %>
      <span>/</span>
      <%= link_to page_title, @wiki, class: "hover:text-slate-800 truncate max-w-xs" %>
      <span>/</span>
      <span class="font-medium text-slate-700">Edit</span>
    </nav>

    <!-- Header & Quick Show Link -->
    <div class="flex items-start justify-between mb-6">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Edit Wiki Page</h1>
        <p class="mt-1 text-sm text-slate-500">
          Make updates to <span class="font-medium text-slate-700">"<%= page_title %>"</span>.
        </p>
      </div>

      <%= link_to @wiki, class: "inline-flex items-center gap-1 text-xs font-semibold text-slate-600 hover:text-rose-600 transition-colors pt-2" do %>
        <span>View current page</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      <% end %>
    </div>

    <!-- Render Shared Form Partial -->
    <%= render "form", wiki: @wiki %>

  </div>
</div>