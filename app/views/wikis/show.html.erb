<% page_title = @wiki.try(:title) || @wiki.try(:name) || "Wiki ##{@wiki.id}" %>
<% content_for :title, page_title %>

<!-- Flash Notice -->
<% if notice.present? %>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
    <div class="rounded-md border-l-4 border-green-500 bg-green-50 p-4 shadow-sm">
      <p class="text-sm font-medium text-green-800"><%= notice %></p>
    </div>
  </div>
<% end %>

<div class="mx-auto flex w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8">

  <!-- ================= LEFT SIDEBAR (NAVIGATION) ================= -->
  <aside class="hidden lg:block w-64 shrink-0 py-8 pr-6 border-r border-slate-200 text-sm">
    <nav class="sticky top-20 space-y-6">
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-400 mb-2.5">Navigation</h3>
        <ul class="space-y-1.5">
          <li>
            <%= link_to wikis_path, class: "flex items-center gap-2 rounded-md px-2.5 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors" do %>
              <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>Back to Directory</span>
            <% end %>
          </li>
          <li>
            <%= link_to new_wiki_path, class: "flex items-center gap-2 rounded-md px-2.5 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors" do %>
              <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>New Wiki Page</span>
            <% end %>
          </li>
        </ul>
      </div>
    </nav>
  </aside>

  <!-- ================= MAIN ARTICLE BODY ================= -->
  <main class="flex-1 min-w-0 py-8 lg:px-8">
    <div class="max-w-3xl">

      <!-- Breadcrumbs & Actions Strip -->
      <div class="flex items-center justify-between text-xs text-slate-500 mb-4 pb-3 border-b border-slate-200">
        <nav class="flex items-center gap-1.5">
          <%= link_to "Wiki", wikis_path, class: "hover:text-slate-800" %>
          <span>/</span>
          <span class="font-medium text-slate-700 truncate max-w-xs"><%= page_title %></span>
        </nav>
        
        <div class="flex items-center gap-3">
          <%= link_to edit_wiki_path(@wiki), class: "inline-flex items-center gap-1 text-slate-600 hover:text-rose-600 transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Edit
          <% end %>

          <%= button_to @wiki, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this wiki?" }, class: "inline-flex items-center gap-1 text-slate-400 hover:text-red-600 transition-colors bg-transparent border-0 p-0 cursor-pointer text-xs" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Delete
          <% end %>
        </div>
      </div>

      <!-- Article Header -->
      <div class="mb-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl"><%= page_title %></h1>
        <p class="mt-2 text-xs text-slate-400">
          Last updated <%= time_ago_in_words(@wiki.updated_at) %> ago • Created on <%= @wiki.created_at.strftime("%B %d, %Y") %>
        </p>
      </div>

      <!-- Classic Wiki Infobox -->
      <aside class="my-4 sm:ml-6 sm:float-right sm:w-64 rounded-lg border border-slate-200 bg-white p-4 shadow-sm text-xs">
        <div class="border-b border-slate-100 pb-2 mb-3 text-center">
          <h4 class="font-bold text-sm text-slate-900">Document Metadata</h4>
          <span class="text-slate-400 font-mono text-[11px]">ID #<%= @wiki.id %></span>
        </div>
        <dl class="space-y-2">
          <div class="flex justify-between">
            <dt class="font-medium text-slate-500">Created:</dt>
            <dd class="text-slate-800"><%= @wiki.created_at.strftime("%b %d, %Y") %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="font-medium text-slate-500">Updated:</dt>
            <dd class="text-slate-800"><%= @wiki.updated_at.strftime("%b %d, %Y") %></dd>
          </div>
          <div class="flex justify-between border-t border-slate-100 pt-2">
            <dt class="font-medium text-slate-500">Status:</dt>
            <dd><span class="rounded bg-emerald-50 px-1.5 py-0.5 font-medium text-[11px] text-emerald-700">Published</span></dd>
          </div>
        </dl>
      </aside>

      <!-- Article Content -->
      <article class="prose prose-slate max-w-none text-sm text-slate-700 leading-relaxed space-y-4">
        <% content = @wiki.try(:content) || @wiki.try(:body) || @wiki.try(:description) %>
        <% if content.present? %>
          <% if defined?(ActionText::RichText) && content.is_a?(ActionText::RichText) %>
            <%= content %>
          <% else %>
            <%= simple_format(content, class: "whitespace-pre-line") %>
          <% end %>
        <% else %>
          <p class="italic text-slate-400">This article has no content yet.</p>
        <% end %>
      </article>

      <div class="mt-12 pt-6 border-t border-slate-200">
        <%= link_to "← Back to all wikis", wikis_path, class: "text-xs font-semibold text-rose-600 hover:text-rose-700" %>
      </div>

    </div>
  </main>

  <!-- ================= RIGHT SIDEBAR ================= -->
  <aside class="hidden xl:block w-56 shrink-0 py-8 pl-6 text-xs">
    <div class="sticky top-20 rounded-lg border border-slate-200/60 bg-white p-4 shadow-sm">
      <h4 class="font-semibold text-slate-900 mb-2 uppercase text-[11px] tracking-wider">Quick Actions</h4>
      <div class="space-y-2">
        <%= link_to "Edit this page", edit_wiki_path(@wiki), class: "block text-rose-600 hover:underline font-medium" %>
        <%= link_to "Create another wiki", new_wiki_path, class: "block text-slate-600 hover:text-slate-900" %>
      </div>
    </div>
  </aside>

</div>