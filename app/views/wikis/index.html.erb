<% content_for :title, "Wikis" %>

<!-- Flash Notice -->
<% if notice.present? %>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
    <div class="rounded-md border-l-4 border-green-500 bg-green-50 p-4 shadow-sm">
      <p class="text-sm font-medium text-green-800"><%= notice %></p>
    </div>
  </div>
<% end %>

<!-- ================= MAIN LAYOUT WRAPPER ================= -->
<div class="mx-auto flex w-full max-w-7xl flex-1 px-4 sm:px-6 lg:px-8">

  <!-- ================= LEFT SIDEBAR (DYNAMIC NAVIGATION) ================= -->
  <aside class="hidden lg:block w-64 shrink-0 py-8 pr-6 border-r border-slate-200 text-sm">
    <nav class="sticky top-20 space-y-6">
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-wider text-slate-400 mb-2.5">All Pages</h3>
        <ul class="space-y-1.5">
          <% if @wikis.any? %>
            <% @wikis.each do |wiki| %>
              <li>
                <%= link_to (wiki.try(:title) || wiki.try(:name) || "Wiki ##{wiki.id}"), wiki, class: "block rounded-md px-2.5 py-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors" %>
              </li>
            <% end %>
          <% else %>
            <li class="px-2.5 text-slate-400 italic">No pages yet</li>
          <% end %>
        </ul>
      </div>
    </nav>
  </aside>

  <!-- ================= CENTER ARTICLE LIST ================= -->
  <main class="flex-1 min-w-0 py-8 lg:px-8">
    <div class="max-w-3xl">

      <!-- Index Header -->
      <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Wiki Directory</h1>
          <p class="mt-2 text-sm text-slate-500">Knowledge base and documentation</p>
        </div>
        <%= link_to new_wiki_path, class: "inline-flex items-center gap-1.5 rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500 transition-colors" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New Page
        <% end %>
      </div>

      <!-- Wikis Loop -->
      <div id="wikis" class="space-y-5">
        <% if @wikis.any? %>
          <% @wikis.each do |wiki| %>
            <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm hover:border-rose-300 hover:shadow transition-all">
              <div class="flex justify-between items-start">
                <h3 class="text-lg font-bold text-slate-900">
                  <%= link_to (wiki.try(:title) || wiki.try(:name) || "Wiki ##{wiki.id}"), wiki, class: "hover:text-rose-600" %>
                </h3>
                <span class="text-xs text-slate-400 whitespace-nowrap"><%= time_ago_in_words(wiki.created_at) %> ago</span>
              </div>
              
              <!-- Preview excerpt (strips HTML if you use a rich text editor) -->
              <p class="mt-2 text-sm text-slate-600 line-clamp-2">
                <%= strip_tags(wiki.try(:content) || wiki.try(:body) || wiki.try(:description) || "Click to read this article.") %>
              </p>

              <div class="mt-4 flex gap-4 text-xs font-medium">
                <%= link_to wiki, class: "text-rose-600 hover:text-rose-700 flex items-center gap-1" do %>
                  Read article <span aria-hidden="true">&rarr;</span>
                <% end %>
                <%= link_to "Edit", edit_wiki_path(wiki), class: "text-slate-400 hover:text-slate-600" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-16 bg-white rounded-lg border border-slate-200 border-dashed">
            <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            <h3 class="mt-2 text-sm font-semibold text-slate-900">No pages</h3>
            <p class="mt-1 text-sm text-slate-500 mb-4">Get started by creating your first documentation page.</p>
            <%= link_to "Create a Wiki", new_wiki_path, class: "text-rose-600 font-semibold text-sm hover:underline" %>
          </div>
        <% end %>
      </div>

    </div>
  </main>

  <!-- ================= RIGHT SIDEBAR (INDEX STATS) ================= -->
  <aside class="hidden xl:block w-56 shrink-0 py-8 pl-6 text-xs">
    <div class="sticky top-20 rounded-lg border border-slate-100 bg-slate-50 p-4">
      <h4 class="font-semibold text-slate-900 mb-3 tracking-wide uppercase text-[11px]">Directory Stats</h4>
      <ul class="space-y-3 text-slate-600">
        <li class="flex justify-between border-b border-slate-200 pb-2">
          <span>Total Pages</span>
          <span class="font-bold text-slate-900"><%= @wikis.size %></span>
        </li>
        <li class="flex justify-between border-b border-slate-200 pb-2">
          <span>Last Updated</span>
          <span class="font-medium text-slate-900"><%= @wikis.maximum(:updated_at)&.strftime("%b %d") || "N/A" %></span>
        </li>
      </ul>
    </div>
  </aside>

</div>