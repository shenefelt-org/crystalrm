<% content_for :title, "Log in" %>

<!-- Responsive Full-Height Centering Canvas -->
<div class="min-h-[calc(100vh-10rem)] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  
  <div class="w-full max-w-md">
    
    <!-- Flash / Notice / Alert (Floating Above Card on Mobile) -->
    <% if alert.present? %>
      <div class="mb-4 flex items-center gap-2.5 bg-red-50 border border-red-200/80 p-3.5 sm:p-4 rounded-xl text-xs sm:text-sm font-medium text-red-800 shadow-sm" id="alert">
        <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <span><%= alert %></span>
      </div>
    <% end %>

    <% if notice.present? %>
      <div class="mb-4 flex items-center gap-2.5 bg-emerald-50 border border-emerald-200/80 p-3.5 sm:p-4 rounded-xl text-xs sm:text-sm font-medium text-emerald-800 shadow-sm" id="notice">
        <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span><%= notice %></span>
      </div>
    <% end %>

    <!-- Card Container -->
    <div class="bg-white rounded-2xl shadow-sm sm:shadow-md border border-slate-200/90 overflow-hidden w-full transition-all">
      
      <!-- Header Section -->
      <div class="flex items-center gap-3.5 p-5 sm:p-6 border-b border-slate-100 bg-slate-50/50">
        <div class="flex items-center justify-center w-11 h-11 bg-[#F4F5FD] border border-[#E8EAFA] text-[#6B7CE6] rounded-xl shrink-0 shadow-2xs">
          <!-- Crystal SVG -->
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 3h6l6.75 3-8.25 15L2.25 6z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L12 9l9.75-3" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v12" />
          </svg>
        </div>
        <div class="min-w-0">
          <h1 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug truncate">Log in</h1>
          <p class="text-xs text-slate-500 mt-0.5 truncate">Welcome back to your portal</p>
        </div>
      </div>

      <!-- Form Body -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "p-5 sm:p-6 space-y-4" }) do |f| %>
        
        <!-- Email Field -->
        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.email_field :email, 
                            autofocus: true, 
                            autocomplete: "email", 
                            placeholder: "name@company.com", 
                            class: "w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-base sm:text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#6B7CE6] focus:outline-none focus:ring-2 focus:ring-[#6B7CE6]/20 transition-all shadow-2xs" %>
        </div>

        <!-- Password Field -->
        <div>
          <%= f.label :password, class: "block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5" %>
          <%= f.password_field :password, 
                               autocomplete: "current-password", 
                               placeholder: "••••••••", 
                               class: "w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-base sm:text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#6B7CE6] focus:outline-none focus:ring-2 focus:ring-[#6B7CE6]/20 transition-all shadow-2xs" %>
        </div>

        <!-- Remember Me Checkbox -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2 pt-0.5">
            <%= f.check_box :remember_me, 
                            class: "w-4 h-4 rounded border-slate-300 text-[#6B7CE6] focus:ring-[#6B7CE6] cursor-pointer" %>
            <%= f.label :remember_me, class: "text-xs sm:text-sm text-slate-600 cursor-pointer select-none" %>
          </div>
        <% end %>

        <!-- Submit Button -->
        <div class="pt-2">
          <%= f.button "Log in", 
                       type: :submit, 
                       class: "w-full inline-flex items-center justify-center text-sm font-semibold text-white bg-[#6B7CE6] hover:bg-[#5260D4] active:bg-[#404DBA] px-4 py-2.5 rounded-xl transition-all shadow-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#6B7CE6]/40" %>
        </div>
      <% end %>

      <!-- Devise Links Footer -->
      <div class="bg-slate-50/75 border-t border-slate-100 px-5 sm:px-6 py-4 text-center text-xs text-slate-500 flex flex-col gap-1.5 [&_a]:text-[#5260D4] [&_a]:font-medium hover:[&_a]:text-[#404DBA] hover:[&_a]:underline">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>