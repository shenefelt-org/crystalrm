<!-- Unified Container -->
<div class="max-w-md mx-auto my-8 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
  <!-- Modern Flash / Notice Message (Only renders if notice is present) -->
  <% if notice.present? %>
    <div class="flex items-center gap-2 bg-emerald-50 border-b border-emerald-100 p-4 text-sm font-medium text-emerald-800">
      <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <!-- Main Customer Content -->
  <div class="p-6 text-center space-y-4">
    <div>
      <h3 class="text-lg font-bold text-slate-900"><%= @customer.full_name %></h3>
      <p class="text-sm text-slate-500"><%= @customer.email %></p>
      <span class="text-sm text-slate-500"> Active Customer: <%= @customer.active_customer? %> </span>
    </div>

    <!-- Stripe ID Badge -->
    <% if @customer&.stripe_customer_id.present? %>
      <div class="inline-flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg px-4 py-2.5 text-xs text-slate-600 font-mono w-full">
        <span class="text-[10px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Stripe Customer ID</span>
        <%= @customer.stripe_customer_id %>
      </div>
    <% else %>
      <span class="inline-block text-xs text-slate-400 italic">No Stripe Customer ID linked</span>
    <% end %>

    <!-- Account Balance -->
    <% if @customer.balance.present? %>
      <div class="inline-flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg px-4 py-2.5 text-xs text-slate-600 font-mono w-full">
        <span class="text-[10px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Account Balance</span>
        <%= @customer.balance.format %>
      </div>
    <% else %>
      <span class="inline-block text-xs text-slate-400 italic"><%= @customer.full_name %> has no balance.</span>
    <% end %>

    <!-- Default Payment Method -->
    <% if @customer.payment_processor.present? && @pay_method&.data.present?%>
      <div class="inline-flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg px-4 py-2.5 text-xs text-slate-600 font-mono w-full">
        <span class="text-[10px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Default Payment Method</span>
        <span> <%= @pay_method[:brand] %> <%= @pay_method[:last4] %> </span>
        <span> <%= @pay_method[:exp_month] %>/<%= @pay_method[:exp_year] %> </span>

      </div>
      
    <% else %>
      <span class="inline-block text-xs text-slate-400 italic"><%= @customer.full_name %> has no default payment method.</span>
    <% end %>


    <!-- Active Subscriptions List -->
    <% active_subs = @customer.subscriptions.select { |sub| sub.status.downcase == 'active' } %>
    <% if active_subs.any? %>
      <div class="flex flex-col gap-2 bg-slate-50 border border-slate-100 rounded-lg p-3 text-xs text-slate-600 font-mono w-full text-left">
        <span class="text-[10px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-1">Active Subscriptions</span>
        
        <% active_subs.each do |sub| %>
          <div class="flex items-center justify-between bg-white border border-slate-200 rounded-md p-2.5 shadow-xs">
            <div>
              <div class="font-bold text-slate-800 font-sans"><%= sub.item&.name || "Unknown Plan" %></div>
              <div class="text-[10px] text-slate-400 truncate max-w-[180px]"><%= sub.stripe_subscription_id %></div>
            </div>
            
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border bg-lime-100 text-lime-900 border-lime-300">
              Active
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <span class="inline-block text-xs text-slate-400 italic"><%= @customer.full_name %> has no active subscriptions.</span>
    <% end %>
  </div>

  <!-- Bottom Action Footer -->
  <div class="flex items-center justify-between gap-3 bg-slate-50 border-t border-slate-100 px-6 py-4">
    <div class="flex items-center gap-4 text-sm">
      <%= link_to customers_path, class: "text-slate-600 hover:text-slate-900 font-medium transition-colors" do %>
        Back
      <% end %>

      <%= link_to "Edit Details", edit_customer_path(@customer), class: "text-blue-600 hover:text-blue-700 font-medium transition-colors" %>
    </div>

    <%= button_to @customer,
                  method: :delete,
                  data: { confirm: "Are you sure?" },
                  class: "text-sm text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-md font-medium transition-all" do %>
      Delete Customer
    <% end %>
  </div>
</div>