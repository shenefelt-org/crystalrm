<div id="<%= dom_id project %>">
  <div>
    <strong>Name:</strong>
    <%= project.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= project.description %>
  </div>

  <div>
    <strong>Project value:</strong>
    <%= project.project_value %>
  </div>

  <div>
    <strong>Customer:</strong>
    <%= project.customer_id %>
  </div>

  <div>
    <strong>User:</strong>
    <%= project.user_id %>
  </div>

</div>
