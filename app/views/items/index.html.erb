<% content_for :title, "Items" %>

<!-- Unified Container -->
<div class="max-w-4xl mx-auto my-8 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
  
  <!-- Flash / Notice Banner -->
  <% if notice.present? %>
    <div class="flex items-center gap-2 bg-emerald-50 border-b border-emerald-100 p-4 text-sm font-medium text-emerald-800" id="notice">
      <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <!-- Header Section with Crystal Icon -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-6 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="flex items-center justify-center w-10 h-10 bg-purple-50 border border-purple-100 text-purple-600 rounded-lg shrink-0">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 3h6l6.75 3-8.25 15L2.25 6z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L12 9l9.75-3" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v12" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-slate-900">Items</h1>
        <p class="text-xs text-slate-500 mt-0.5">Manage catalog items, pricing, and Stripe bindings</p>
      </div>
    </div>

    <%= link_to new_item_path, class: "inline-flex items-center justify-center gap-1.5 text-sm text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg font-medium transition-all shadow-sm shrink-0" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <span>New Item</span>
    <% end %>
  </div>

  <!-- Items List -->
  <div id="items" class="divide-y divide-slate-100">
    <% if @items.any? %>
      <% @items.each do |item| %>
        <div class="p-6 hover:bg-slate-50/75 transition-colors">
          
          <!-- Top Row: Icon, Name, Price, Status, Description & Actions -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            
            <div class="min-w-0 flex-1 flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 3h6l6.75 3-8.25 15L2.25 6z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L12 9l9.75-3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v12" />
              </svg>

              <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h2 class="text-base font-semibold text-slate-900">
                    <%= item.name.presence || "Untitled Item" %>
                  </h2>

                  <!-- Formatted Money-Rails Price -->
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-slate-100 text-slate-800">
                    <%= humanized_money_with_symbol(item.price) %>
                  </span>

                  <!-- Active / Inactive Badge -->
                  <% if item.respond_to?(:active?) && item.active? %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/70">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                      Inactive
                    </span>
                  <% end %>
                </div>

                <!-- Description -->
                <% if item.description.present? %>
                  <p class="text-sm text-slate-600 mt-1.5 leading-relaxed">
                    <%= item.description %>
                  </p>
                <% else %>
                  <p class="text-xs text-slate-400 italic mt-1.5">No description provided.</p>
                <% end %>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0 self-end sm:self-start">
              <%= link_to "Show", item, class: "text-xs font-medium text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200/80 px-3 py-1.5 rounded-md transition-colors" %>
              <%= link_to "Edit", edit_item_path(item), class: "text-xs font-medium text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-md transition-colors" %>
              <%= button_to "Delete", item, 
                            method: :delete, 
                            data: { turbo_confirm: "Are you sure you want to delete this item?" }, 
                            class: "text-xs font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-md transition-colors cursor-pointer" %>
            </div>
          </div>

          <!-- Bottom Row: Read-Only Stripe ID Badges -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 pt-4 border-t border-slate-100">
            <% if item.stripe_product_id.present? %>
              <div class="flex flex-col bg-slate-50 border border-slate-100 rounded-lg px-3 py-2 text-xs font-mono text-slate-600">
                <span class="text-[9px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Stripe Product ID (Read-Only)</span>
                <span class="truncate" title="<%= item.stripe_product_id %>"><%= item.stripe_product_id %></span>
              </div>
            <% else %>
              <div class="flex items-center justify-center bg-slate-50/50 border border-dashed border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-400 italic">
                No Stripe Product ID
              </div>
            <% end %>

            <% if item.stripe_price_id.present? %>
              <div class="flex flex-col bg-slate-50 border border-slate-100 rounded-lg px-3 py-2 text-xs font-mono text-slate-600">
                <span class="text-[9px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Stripe Price ID (Read-Only)</span>
                <span class="truncate" title="<%= item.stripe_price_id %>"><%= item.stripe_price_id %></span>
              </div>
            <% else %>
              <div class="flex items-center justify-center bg-slate-50/50 border border-dashed border-slate-200 rounded-lg px-3 py-2 text-xs text-slate-400 italic">
                No Stripe Price ID
              </div>
            <% end %>
          </div>

        </div>
      <% end %>
    <% else %>
      <div class="py-12 px-6 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-purple-50 text-purple-400 mb-3 border border-purple-100">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 3h6l6.75 3-8.25 15L2.25 6z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L12 9l9.75-3" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v12" />
          </svg>
        </div>
        <p class="text-sm font-medium text-slate-700">No items found</p>
        <p class="text-xs text-slate-400 mt-1">Get started by creating your first item.</p>
        <div class="mt-4">
          <%= link_to "Create Item", new_item_path, class: "inline-flex items-center text-xs font-medium text-blue-600 hover:text-blue-700 hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Bottom Footer Counter -->
  <% if @items.any? %>
    <div class="flex items-center justify-between bg-slate-50 border-t border-slate-100 px-6 py-3.5 text-xs text-slate-500">
      <span>Total: <%= pluralize(@items.count, "item") %></span>
    </div>
  <% end %>

</div>