<!-- Unified Container -->
<div class="max-w-md mx-auto my-8 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
  
  <!-- Flash / Notice Message -->
  <% if notice.present? %>
    <div class="flex items-center gap-2 bg-emerald-50 border-b border-emerald-100 p-4 text-sm font-medium text-emerald-800">
      <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <!-- Main Item Content -->
  <div class="p-6">
    <!-- Header with Crystal Icon, Name, Price & Status Badge -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <div class="flex items-start gap-2.5">
        <svg class="w-6 h-6 text-purple-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 3h6l6.75 3-8.25 15L2.25 6z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L12 9l9.75-3" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v12" />
        </svg>

        <div>
          <h1 class="text-xl font-bold text-slate-900 leading-tight">
            <%= @item.name.presence || "Untitled Item" %>
          </h1>
          <!-- Prominent Money-Rails Price -->
          <div class="text-lg font-bold text-slate-800 mt-1">
            <%= humanized_money_with_symbol(@item.price) %>
          </div>
        </div>
      </div>

      <% if @item.respond_to?(:active?) && @item.active? %>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 mt-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/70 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Active
        </span>
      <% else %>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 mt-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          Inactive
        </span>
      <% end %>
    </div>

    <!-- Description -->
    <div class="mb-6">
      <% if @item.description.present? %>
        <p class="text-sm text-slate-600 leading-relaxed"><%= @item.description %></p>
      <% else %>
        <p class="text-xs text-slate-400 italic">No description provided.</p>
      <% end %>
    </div>

    <!-- Stripe Read-Only Badges -->
    <div class="space-y-2.5 pt-4 border-t border-slate-100">
      <% if @item&.stripe_product_id.present? %>
        <div class="flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg px-4 py-2 text-xs text-slate-600 font-mono w-full text-center">
          <span class="text-[9px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Stripe Product ID</span>
          <span class="truncate max-w-full" title="<%= @item.stripe_product_id %>"><%= @item.stripe_product_id %></span>
        </div>
      <% else %>
        <div class="flex items-center justify-center bg-slate-50/50 border border-dashed border-slate-200 rounded-lg px-4 py-2 text-xs text-slate-400 italic">
          No Stripe Product ID linked
        </div>
      <% end %>

      <% if @item&.stripe_price_id.present? %>
        <div class="flex flex-col items-center justify-center bg-slate-50 border border-slate-100 rounded-lg px-4 py-2 text-xs text-slate-600 font-mono w-full text-center">
          <span class="text-[9px] uppercase tracking-wider font-sans font-bold text-slate-400 mb-0.5">Stripe Price ID</span>
          <span class="truncate max-w-full" title="<%= @item.stripe_price_id %>"><%= @item.stripe_price_id %></span>
        </div>
      <% else %>
        <div class="flex items-center justify-center bg-slate-50/50 border border-dashed border-slate-200 rounded-lg px-4 py-2 text-xs text-slate-400 italic">
          No Stripe Price ID linked
        </div>
      <% end %>
    </div>
  </div>

  <!-- Bottom Action Footer -->
  <div class="flex items-center justify-between gap-3 bg-slate-50 border-t border-slate-100 px-6 py-4">
    <div class="flex items-center gap-4 text-sm">
      <%= link_to items_path, class: "text-slate-600 hover:text-slate-900 font-medium transition-colors" do %>
        Back
      <% end %>
      
      <%= link_to "Edit Item", edit_item_path(@item), class: "text-blue-600 hover:text-blue-700 font-medium transition-colors" %>
    </div>

    <%= button_to @item, 
                  method: :delete, 
                  data: { turbo_confirm: "Are you sure you want to delete this item?" }, 
                  class: "text-sm text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-md font-medium transition-all cursor-pointer" do %>
      Delete Item
    <% end %>
  </div>

</div>